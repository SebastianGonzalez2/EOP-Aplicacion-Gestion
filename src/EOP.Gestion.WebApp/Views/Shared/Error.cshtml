@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">No pudimos completar la solicitud</h1>
<p>Ocurrió un error inesperado. Intentá nuevamente más tarde.</p>

@if (Model.ShowRequestId)
{
    <p>Si necesitás ayuda, compartí este identificador: <code>@Model.RequestId</code></p>
}
