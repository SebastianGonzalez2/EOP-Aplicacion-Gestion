@*
    Layout general de EOP (alternativa A de docs/diseno-visual.md, sección 6).

    Tiene dos formas:
    - Con sesión: menú lateral verde a la izquierda, barra blanca arriba y el contenido
      de la pantalla en el medio. Es lo que ve cualquier usuario que ya entró.
    - Sin sesión: solo la marca y un panel centrado, para las pocas pantallas públicas
      (sesión cerrada, error al iniciar sesión). No tiene sentido mostrar un menú a
      alguien que todavía no entró.

    Una pantalla puede pedir una clase extra para el área de contenido con
    ViewData["ClaseContenido"]. Hoy solo la usa el inicio, para centrar su panel.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EOP</title>
    <script type="importmap"></script>
    @* Todo se sirve desde wwwroot: Bootstrap, los íconos y las fuentes están en wwwroot/lib.
       No dependemos de Google Fonts ni de ningún CDN (sección 21.2 de la guía). *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="app">
            <partial name="_MenuLateral" />

            <div class="principal">
                <header class="superior">
                    @* En celulares y tablets el menú se esconde y este botón lo abre como panel lateral. *@
                    <button class="btn btn-outline-secondary d-lg-none px-2 py-1" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#menuLateral" aria-controls="menuLateral"
                            aria-label="Abrir menú">
                        <i class="bi bi-list fs-5" aria-hidden="true"></i>
                    </button>

                    <div class="ms-auto">
                        <partial name="_EstadoSesionPartial" />
                    </div>
                </header>

                <main class="contenido @ViewData["ClaseContenido"]">
                    @RenderBody()
                </main>
            </div>
        </div>

        @* S3-T15: si el usuario tiene cambios sin guardar en algún presupuesto, acá se dibuja
           el diálogo que aparece al cerrar sesión (desde cualquier pantalla). *@
        @await Component.InvokeAsync("AdvertenciaCierreSesion")
    }
    else
    {
        <div class="pagina-publica">
            <div class="marca-publica" aria-hidden="true">EOP</div>
            <main>
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        @* S3-T15: advertencias de cambios sin guardar (cierre de sesión, datos no enviados y
           advertencia nativa del navegador). Va antes de los scripts propios de cada pantalla. *@
        <script src="~/js/cambios-pendientes.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
