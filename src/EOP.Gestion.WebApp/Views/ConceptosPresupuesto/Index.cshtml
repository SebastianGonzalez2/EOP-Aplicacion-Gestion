@using System.Globalization
@using EOP.Gestion.Core.Comun
@using EOP.Gestion.Core.Entidades.Presupuestos
@model EOP.Gestion.WebApp.ViewModels.Presupuestos.ConceptosPresupuestoViewModel

@{
    ViewData["Title"] = Model.Informacion.NombreProyecto;
    var cultura = CultureInfo.GetCultureInfo("es-UY");
    var informacion = Model.Informacion;
    string indicadorPendientes = Model.TieneCambiosPendientes ? "true" : "false";
}

@* UI-presupuestos: pantalla única del presupuesto (US-001, US-003, US-007, US-010A, US-011).
   Reúne la información general que antes estaba en «Detalle del presupuesto» y la tabla de
   conceptos. De arriba hacia abajo: ruta, encabezado con estado y «Guardar borrador», etapas,
   información general, aviso de cambios sin guardar, tabla con «Agregar concepto» y, al final,
   las acciones de navegación y descarte. Lo que se puede hacer depende de los permisos que
   calcula el servidor (PuedeAgregar); ocultar un botón acá no reemplaza ese control (RNF-4). *@

<div data-borrador-presupuesto data-presupuesto-id="@Model.PresupuestoId" data-cambios-pendientes="@indicadorPendientes">
    <nav aria-label="Ruta de navegación">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Presupuestos" asp-action="Index">Presupuestos</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Codigo</li>
        </ol>
    </nav>

    <div class="encabezado">
        <div class="encabezado-presupuesto">
            <h1>@informacion.NombreProyecto</h1>
            <p class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-break">Código: @Model.Codigo</span>
                <partial name="_EtiquetaEstadoPresupuesto" model="informacion.Estado" />
            </p>
        </div>

        @if (Model.PuedeAgregar)
        {
            @* US-003 (RF-05): único botón primario de la pantalla. Solo al presionarlo se guardan
               definitivamente en la base de datos los conceptos y selecciones del borrador. *@
            <form id="formulario-guardar-borrador"
                  asp-action="GuardarBorrador"
                  asp-route-id="@Model.PresupuestoId"
                  method="post">
                <input type="hidden" name="esperabaCambiosPendientes" value="@indicadorPendientes" />
                <input type="hidden" name="borradorId" value="@Model.BorradorId" />
                <input type="hidden" name="versionBorrador" value="@Model.VersionBorrador" />
                <input type="hidden" name="huellaEstadoBase" value="@Model.HuellaEstadoBase" />
                <button type="submit" class="btn btn-primary">
                    <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                    <i class="bi bi-check2 me-1" data-icono-guardar aria-hidden="true"></i>
                    <span data-texto-guardar>Guardar borrador</span>
                </button>
            </form>
        }
    </div>

    <partial name="_Mensajes" />

    @* S3-T19: si no podemos obtener una cotización válida,
       informamos al usuario sin impedir que continúe trabajando
       o guardando el borrador del presupuesto. *@
    @if (!string.IsNullOrWhiteSpace(Model.MensajeErrorCotizacion))
    {
        <div class="alert mensaje mensaje-info" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <div class="mensaje-cuerpo">
                @Model.MensajeErrorCotizacion
            </div>
        </div>
    }

    @* RNF-19 (docs/diseno-visual.md sección 19): indicador informativo de etapas del proceso. *@
    <section class="panel mb-4" aria-label="Etapas del presupuesto">
        <ol class="etapas">
            <li class="etapa etapa-actual" aria-current="step">
                <span class="etapa-marca">1</span>
                <span class="etapa-nombre">Elaboración<span class="etapa-estado">Etapa actual</span></span>
            </li>
            <li class="etapa">
                <span class="etapa-marca">2</span>
                <span class="etapa-nombre">Resumen<span class="etapa-estado">Pendiente</span></span>
            </li>
            <li class="etapa">
                <span class="etapa-marca">3</span>
                <span class="etapa-nombre">Documentos<span class="etapa-estado">Pendiente</span></span>
            </li>
            <li class="etapa">
                <span class="etapa-marca">4</span>
                <span class="etapa-nombre">Revisión interna<span class="etapa-estado">Pendiente</span></span>
            </li>
        </ol>
    </section>

    @* Información general del presupuesto (US-001). Son los mismos datos que mostraba la pantalla
       de detalle, ahora en una tarjeta compacta: en pantallas anchas van en una fila y en un
       celular se acomodan de a dos o de a uno (RNF-14). Se muestran sin modificarlos. *@
    <section class="panel mb-4" aria-labelledby="titulo-informacion-general">
        <h2 id="titulo-informacion-general" class="visually-hidden">Información general</h2>
        <dl class="datos-generales datos-compactos mb-0">
            <div class="dato">
                <dt>Código del presupuesto</dt>
                <dd class="text-break">@informacion.Codigo</dd>
            </div>
            <div class="dato">
                <dt>Nombre del proyecto</dt>
                <dd>@informacion.NombreProyecto</dd>
            </div>
            <div class="dato">
                <dt>Cliente</dt>
                <dd>@informacion.NombreCliente</dd>
            </div>
            <div class="dato">
                <dt>Tipo de proyecto</dt>
                <dd>@informacion.NombreTipoProyecto</dd>
            </div>
            <div class="dato">
                <dt>Responsable</dt>
                <dd>@informacion.NombreResponsable</dd>
            </div>
            <div class="dato">
                <dt>Fecha de creación</dt>
                <dd class="num">@ZonaHorariaUruguay.ConvertirUtcALocal(informacion.FechaCreacion).ToString("dd/MM/yyyy")</dd>
            </div>
            <div class="dato">
                <dt>Plazo de vigencia</dt>
                <dd class="num">@informacion.PlazoVigenciaDias días</dd>
            </div>
            <div class="dato">
                <dt>Estado actual</dt>
                <dd><partial name="_EtiquetaEstadoPresupuesto" model="informacion.Estado" /></dd>
            </div>
        </dl>
    </section>

    @if (!Model.PuedeAgregar)
    {
        @* US-001: un presupuesto que no se puede editar (por su estado o por los permisos del
           usuario) se puede consultar igual. Avisamos por qué no aparecen las acciones. *@
        <div class="alert mensaje mensaje-info" role="status">
            <i class="bi bi-info-circle" aria-hidden="true"></i>
            <div class="mensaje-cuerpo">
                Estás consultando este presupuesto. Por su estado o por tus permisos, no podés modificarlo.
            </div>
        </div>
    }

    @if (Model.PuedeAgregar && Model.TieneCambiosPendientes)
    {
        <partial name="_IndicadorCambiosSinGuardar" />
    }

    <section class="panel mb-4" aria-labelledby="titulo-conceptos">
        <div class="panel-encabezado">
            <h2 id="titulo-conceptos">Conceptos del presupuesto</h2>
            @if (Model.PuedeAgregar)
            {
                @* US-011: abre el modal para agregar un concepto. El formulario ya no está fijo
                   debajo de la tabla: aparece solo cuando el usuario lo pide. *@
                <button type="button" class="btn btn-outline-secondary"
                        data-bs-toggle="modal" data-bs-target="#modalAgregarConcepto">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Agregar concepto
                </button>
            }
        </div>

        @if (Model.Filas.Count == 0)
        {
            <div class="sin-resultados" role="status">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <h3>Todavía no hay conceptos registrados.</h3>
                @if (Model.PuedeAgregar)
                {
                    <p>Usá «Agregar concepto» para incorporar materiales, mano de obra u otros conceptos.</p>
                }
            </div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Tabla de conceptos">
                <table class="table table-hover tabla mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Tipo</th>
                            <th scope="col">Concepto detectado</th>
                            <th scope="col" class="col-principal">Concepto</th>
                            <th scope="col">Proveedor</th>
                            <th scope="col" class="text-end">Cantidad</th>
                            <th scope="col">Unidad</th>
                            <th scope="col" class="text-end">Precio / Valor</th>
                            <th scope="col" class="text-end">Subtotal</th>
                            @if (Model.PuedeAgregar)
                            {
                                <th scope="col" class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in Model.Filas)
                        {
                            string valor = "—";
                            if (fila.PrecioUnitario is decimal importe)
                            {
                                valor = $"{fila.Moneda} {importe.ToString("0.##########", cultura)}";
                            }

                            bool filaMaterial = fila.TipoId == TipoConcepto.MaterialId;
                            bool filaMargen = fila.TipoId == TipoConcepto.MargenId;

                            // S3-T17: calculamos el subtotal de los conceptos monetarios usando los valores
                            // históricos que ya tiene guardados el presupuesto.
                            // Conservamos su moneda original, sin hacer conversiones.
                            // S3-T19: el margen tiene su propio cálculo y siempre se expresa en UYU.
                            string subtotalTexto = "—";

                            if (fila.Subtotal is decimal subtotal && fila.Moneda.HasValue)
                            {
                                subtotalTexto = $"{fila.Moneda} {subtotal.ToString("0.##########", cultura)}";
                            }

                            // Si no podemos calcular el margen, no mostramos
                            // un cero que podría interpretarse como un importe válido.
                            if (filaMargen && !fila.Subtotal.HasValue)
                            {
                                subtotalTexto = "No disponible";
                            }

                            <tr>
                                <td>@fila.Tipo</td>
                                <td class="col-texto">@(fila.ConceptoDetectado ?? "—")</td>

                                @* US-007: una fila Material sin Concepto todavía no tiene material elegido. *@
                                @if (filaMaterial && fila.Concepto == null)
                                {
                                    <td class="col-principal text-body-secondary">Sin material seleccionado</td>
                                }
                                else
                                {
                                    <td class="col-principal">@(fila.Concepto ?? "—")</td>
                                }

                                <td>@(fila.Proveedor ?? "—")</td>
                                <td class="text-end num">@(fila.Cantidad?.ToString("0.##########", cultura) ?? "—")</td>
                                <td>@(fila.Unidad?.ToString() ?? "—")</td>

                                @* S3-T19: mostramos el porcentaje elegido por el usuario
                                   en lugar de un precio unitario cuando el concepto es Margen. *@
                                <td class="text-end num">
                                    @if (filaMargen && fila.PorcentajeMargen.HasValue)
                                    {
                                        @(fila.PorcentajeMargen.Value.ToString("0.##########", cultura) + "%")
                                    }
                                    else if (filaMaterial)
                                    {
                                        @valor
                                    }
                                    else
                                    {
                                        @("—")
                                    }
                                </td>

                                <td class="text-end num">@subtotalTexto</td>

                                @if (Model.PuedeAgregar)
                                {
                                    <td class="col-acciones">
                                        @if (filaMaterial)
                                        {
                                            string textoAccion = fila.MaterialProveedorId == null ? "Seleccionar material" : "Cambiar material";
                                            if (Model.TieneCambiosPendientes)
                                            {
                                                <a asp-action="SeleccionarMaterial" asp-route-id="@Model.PresupuestoId"
                                                   asp-route-conceptoId="@fila.Id"
                                                   asp-route-esperabaCambiosPendientes="true"
                                                   class="btn btn-outline-secondary btn-sm">
                                                    <i class="bi bi-search me-1" aria-hidden="true"></i>@textoAccion
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="SeleccionarMaterial" asp-route-id="@Model.PresupuestoId"
                                                   asp-route-conceptoId="@fila.Id"
                                                   class="btn btn-outline-secondary btn-sm">
                                                    <i class="bi bi-search me-1" aria-hidden="true"></i>@textoAccion
                                                </a>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* S3-T19: identificamos la fuente de las cotizaciones
               utilizadas para convertir los importes en dólares.
               También mostramos el valor y la fecha de publicación
               de la cotización que realmente utilizamos para calcular el margen.
               Si el cálculo no necesitó convertir dólares, no mostramos esta información. *@
            @if (Model.CotizacionUtilizada != null)
            {
                <div class="small text-body-secondary p-3">
                    <p class="mb-1">
                        <strong>Cotización utilizada:</strong>
                        @Model.CotizacionUtilizada.Valor.ToString("0.##########", cultura)
                        UYU/USD
                    </p>

                    <p class="mb-1">
                        <strong>Fecha de publicación:</strong>
                        @Model.CotizacionUtilizada.FechaPublicacion.ToString("dd/MM/yyyy")
                    </p>

                    <p class="mb-0">
                        Fuente de cotizaciones: BCU —
                        Datos de
                        <a href="https://datosuruguay.com/dolar">
                            datosUruguay.com
                        </a>.
                    </p>
                </div>
            }
        }
    </section>

    @* Acciones de navegación y de descarte, al final de la pantalla. Volver al listado no obliga a
       guardar ni a descartar: los cambios quedan en la sesión (S3-T15, navegación libre). *@
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
        <a asp-controller="Presupuestos" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Volver al listado
        </a>

        @* S3-T15: el descarte voluntario solo tiene sentido si hay algo para descartar.
           El botón no descarta: abre el diálogo de confirmación (RNF-1, guía sección 18.1). *@
        @if (Model.PuedeAgregar && Model.TieneCambiosPendientes)
        {
            <button type="button" class="btn btn-outline-danger"
                    data-bs-toggle="modal" data-bs-target="#confirmarDescartarCambios">
                Descartar cambios
            </button>
        }
    </div>

    @if (Model.PuedeAgregar && Model.TieneCambiosPendientes)
    {
        @* S3-T15 (US-003, RF-05, RNF-1): confirmación del descarte voluntario. Manda el
           identificador y la versión del borrador que ve esta pantalla: si otra pestaña lo cambió,
           el servidor no descarta nada. "Cancelar" cierra el diálogo y los cambios siguen ahí. *@
        <div class="modal fade" id="confirmarDescartarCambios" tabindex="-1"
             aria-labelledby="confirmarDescartarCambiosTitulo" aria-hidden="true">
            <div class="modal-dialog">
                <form id="formulario-descartar-cambios" class="modal-content"
                      asp-action="DescartarCambios" asp-route-id="@Model.PresupuestoId" method="post">
                    <input type="hidden" name="borradorId" value="@Model.BorradorId" />
                    <input type="hidden" name="versionBorrador" value="@Model.VersionBorrador" />

                    <div class="modal-header">
                        <h2 class="modal-title" id="confirmarDescartarCambiosTitulo">
                            ¿Descartar los cambios sin guardar de @Model.Codigo?
                        </h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancelar"></button>
                    </div>

                    <div class="modal-body">
                        Se eliminan los conceptos y selecciones que todavía no guardaste en este presupuesto.
                        El presupuesto vuelve a la información del último guardado, que no se modifica.
                        Esta acción no se puede deshacer.
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger">
                            <span class="spinner-border spinner-border-sm me-1 d-none" aria-hidden="true"></span>
                            <span data-texto-guardar>Descartar cambios</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (Model.PuedeAgregar)
    {
        <partial name="_ModalAgregarConcepto" />
    }
</div>

@section Scripts {
    <script src="~/js/selector-materiales.js" asp-append-version="true"></script>
    <script src="~/js/conceptos-presupuesto.js" asp-append-version="true"></script>
}