@using EOP.Gestion.Core.Entidades.Presupuestos
@model List<EOP.Gestion.Core.DTOs.Presupuestos.PresupuestoListadoDto>

@{
    ViewData["Title"] = "Presupuestos";
}

@* Listado de presupuestos (US-001).
   Mostramos los datos principales de cada presupuesto.
   Los filtros se implementarán en S2-T27 y el acceso al detalle en S2-T28. *@

<div class="encabezado">
    <div>
        <h1>Presupuestos</h1>
        <p>Listado de presupuestos registrados en el sistema.</p>
    </div>

    <a asp-controller="Presupuestos"
       asp-action="Crear"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>
        Crear presupuesto
    </a>
</div>

<partial name="_Mensajes" />

<section class="panel" aria-label="Listado de presupuestos">

    @if (Model.Count == 0)
    {
        @* Si no existen presupuestos, mostramos un mensaje. *@
        <div class="sin-resultados" role="status">
            <i class="bi bi-inbox" aria-hidden="true"></i>
            <h2>No se encontraron presupuestos.</h2>
            <p>Todavía no hay presupuestos registrados.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover tabla">
                <thead>
                    <tr>
                        <th scope="col">Código</th>
                        <th scope="col">Nombre del proyecto</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">Fecha</th>
                        <th scope="col">Estado</th>
                        <th scope="col">Responsable</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var presupuesto in Model)
                    {
                        // Convertimos el estado a su nombre visible.
                        // También elegimos el estilo correspondiente.
                        string nombreEstado;
                        string claseEstado;

                        switch (presupuesto.Estado)
                        {
                            case EstadoPresupuesto.Borrador:
                                nombreEstado = "Borrador";
                                claseEstado = "estado-neutro";
                                break;

                            case EstadoPresupuesto.ParaRevisionInterna:
                                nombreEstado = "Para revisión interna";
                                claseEstado = "estado-atencion";
                                break;

                            case EstadoPresupuesto.EnviadoPendienteDeRespuestaDelCliente:
                                nombreEstado = "Enviado / pendiente de respuesta del cliente";
                                claseEstado = "estado-atencion";
                                break;

                            case EstadoPresupuesto.Aprobado:
                                nombreEstado = "Aprobado";
                                claseEstado = "estado-exito";
                                break;

                            case EstadoPresupuesto.Rechazado:
                                nombreEstado = "Rechazado";
                                claseEstado = "estado-negativo";
                                break;

                            case EstadoPresupuesto.SolicitudDeModificacionDelCliente:
                                nombreEstado = "Solicitud de modificación del cliente";
                                claseEstado = "estado-atencion";
                                break;

                            case EstadoPresupuesto.Vencido:
                                nombreEstado = "Vencido";
                                claseEstado = "estado-cerrado";
                                break;

                            case EstadoPresupuesto.Cancelado:
                                nombreEstado = "Cancelado";
                                claseEstado = "estado-cerrado";
                                break;

                            default:
                                nombreEstado = "Estado desconocido";
                                claseEstado = "estado-neutro";
                                break;
                        }

                        <tr>
                            <td class="col-texto">@presupuesto.Codigo</td>

                            <td class="col-principal">
                                @presupuesto.NombreProyecto
                            </td>

                            <td>@presupuesto.NombreCliente</td>

                            <td>
                                @presupuesto.FechaCreacion.ToString("dd/MM/yyyy")
                            </td>

                            <td>
                                <span class="estado @claseEstado">
                                    @nombreEstado
                                </span>
                            </td>

                            <td>@presupuesto.NombreResponsable</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-pie">
            <span class="text-body-secondary small">
                @if (Model.Count == 1)
                {
                    @:Se muestra 1 presupuesto.
                }
                else
                {
                    @:Se muestran @Model.Count presupuestos.
                }
            </span>
        </div>
    }
</section>
