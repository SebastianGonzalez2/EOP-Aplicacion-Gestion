@model EOP.Gestion.WebApp.ViewModels.Presupuestos.CrearPresupuestoViewModel

@{
    ViewData["Title"] = "Crear presupuesto";
}

@* Formulario de creación de presupuestos (US-002).
   Utilizamos los estilos definidos en docs/diseno-visual/diseno-visual.md. *@

<nav aria-label="Ruta de navegación">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-controller="Home" asp-action="Index">Inicio</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">
            Crear presupuesto
        </li>
    </ol>
</nav>

<div class="encabezado">
    <div>
        <h1>Crear presupuesto</h1>
        <p>Ingresá los datos básicos del nuevo presupuesto.</p>
    </div>
</div>

@* Mostramos el mensaje de éxito después de guardar el presupuesto. *@
<partial name="_Mensajes" />

<div class="row g-4">
    <div class="col-xl-8">

        <form asp-controller="Presupuestos"
              asp-action="Crear"
              method="post"
              class="panel">

            @Html.AntiForgeryToken()

            <div class="seccion-form">
                <h2>Datos del presupuesto</h2>
                <p class="descripcion">
                    Seleccioná el cliente e identificá el trabajo a presupuestar.
                </p>

                @* Mostramos los errores generales del formulario. *@
                <div asp-validation-summary="ModelOnly"
                     class="resumen-errores"
                     role="alert"></div>

                <div class="row g-3">

                    <!-- Cliente -->
                    <div class="col-12">
                        <label asp-for="ClienteId" class="form-label">
                            Cliente
                            <span class="obligatorio" aria-hidden="true">*</span>
                        </label>

                        <select asp-for="ClienteId"
                                asp-items="Model.Clientes"
                                class="form-select"
                                required
                                aria-required="true">
                            <option value="">Seleccioná un cliente</option>
                        </select>

                        <span asp-validation-for="ClienteId"
                              class="error-campo"></span>

                        <div class="form-text">
                            ¿El cliente todavía no está registrado?

                            <a asp-controller="Clientes"
                               asp-action="Registrar"
                               target="_blank"
                               rel="noopener noreferrer">
                                Crear cliente
                            </a>
                        </div>
                    </div>

                    <!-- Nombre del proyecto -->
                    <div class="col-12">
                        <label asp-for="NombreProyecto" class="form-label">
                            Nombre del proyecto o trabajo
                            <span class="obligatorio" aria-hidden="true">*</span>
                        </label>

                        <input asp-for="NombreProyecto"
                               class="form-control"
                               maxlength="200"
                               required
                               aria-required="true"
                               placeholder="Ej.: Instalación eléctrica" />

                        <span asp-validation-for="NombreProyecto"
                              class="error-campo"></span>
                    </div>

                    <!-- Tipo de proyecto -->
                    <div class="col-md-6">
                        <label asp-for="TipoProyectoId" class="form-label">
                            Tipo de proyecto
                            <span class="obligatorio" aria-hidden="true">*</span>
                        </label>

                        <select asp-for="TipoProyectoId"
                                asp-items="Model.TiposProyecto"
                                class="form-select"
                                required
                                aria-required="true">
                            <option value="">Seleccioná un tipo</option>
                        </select>

                        <span asp-validation-for="TipoProyectoId"
                              class="error-campo"></span>
                    </div>

                    <!-- Plazo de vigencia -->
                    <div class="col-md-6">
                        <label asp-for="PlazoVigenciaDias" class="form-label">
                            Plazo de vigencia (días corridos)
                            <span class="obligatorio" aria-hidden="true">*</span>
                        </label>

                        <input asp-for="PlazoVigenciaDias"
                               type="number"
                               min="1"
                               step="1"
                               class="form-control"
                               required
                               aria-required="true" />

                        <span asp-validation-for="PlazoVigenciaDias"
                              class="error-campo"></span>
                    </div>

                </div>
            </div>

            <div class="panel-pie d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="small text-body-secondary">
                    <span class="obligatorio ms-0" aria-hidden="true">*</span>
                    Obligatorio
                </span>

                <div class="d-flex gap-2">
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancelar
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Crear presupuesto
                    </button>
                </div>
            </div>

        </form>
    </div>

    <!-- Información adicional -->
    <aside class="col-xl-4">
        <div class="panel panel-cuerpo">
            <h2 class="h6 fw-bold">Antes de crear</h2>

            <ul class="small text-body-secondary ps-3 mb-0 d-grid gap-2">
                <li>Solo podés seleccionar clientes activos.</li>
                <li>El presupuesto comenzará en estado Borrador.</li>
                <li>El código interno será generado automáticamente.</li>
                <li>El Responsable será el usuario que crea el presupuesto.</li>
                <li>El plazo de vigencia se expresa en días corridos.</li>
            </ul>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Personalizamos los mensajes de validación del formulario.
        // Así evitamos que jQuery muestre mensajes en inglés.
        if (window.jQuery && $.validator) {
            $.extend($.validator.messages, {
                min: $.validator.format("El valor debe ser mayor o igual a {0}."),
                max: $.validator.format("El valor debe ser menor o igual a {0}."),
                number: "Ingresá un número válido.",
                step: $.validator.format("Ingresá un múltiplo válido de {0}.")
            });
        }
    </script>
}
