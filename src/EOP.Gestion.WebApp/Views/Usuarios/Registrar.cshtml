@using EOP.Gestion.Core.Entidades.Usuarios
@model EOP.Gestion.WebApp.ViewModels.Usuarios.RegistrarUsuarioViewModel

@{
    ViewData["Title"] = "Registrar usuario";
}

@* Formulario con el diseño de la guía (sección 14 de docs/diseno-visual/diseno-visual.md). *@

<div class="encabezado">
    <div>
        <h1>Registrar usuario</h1>
        <p>
            Ingresá los datos del nuevo usuario de EOP.
            Los campos marcados con <span class="obligatorio ms-0">*</span> son obligatorios.
        </p>
    </div>
</div>

@* Mostramos un mensaje cuando el usuario se registra correctamente. *@
<partial name="_Mensajes" />

<div class="row g-4">
    <div class="col-xl-8">
        @* Como es un POST con asp-action, el Tag Helper agrega solo el token antifalsificación.
           El Estado no aparece porque no se elige: todo usuario nuevo queda Activo (RF-70). *@
        <form id="formulario-registrar-usuario" asp-controller="Usuarios" asp-action="Registrar" method="post" class="panel">
            <div class="seccion-form">
                <h2>Datos del usuario</h2>
                <p class="descripcion">El usuario queda Activo y se vincula con su cuenta de Microsoft en su primer inicio de sesión.</p>

                <div asp-validation-summary="ModelOnly" class="resumen-errores" role="alert"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NombreCompleto" class="form-label">Nombre completo<span class="obligatorio" aria-hidden="true">*</span></label>
                        <input asp-for="NombreCompleto" class="form-control" aria-required="true" />
                        <span asp-validation-for="NombreCompleto" class="error-campo"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CorreoCorporativo" class="form-label">Correo corporativo<span class="obligatorio" aria-hidden="true">*</span></label>
                        <input asp-for="CorreoCorporativo" type="email" class="form-control" aria-required="true" aria-describedby="ayuda-correo-corporativo" />
                        <div id="ayuda-correo-corporativo" class="form-text">
                            Tiene que ser el correo de su cuenta de Microsoft, que debe existir antes de este registro.
                        </div>
                        <span asp-validation-for="CorreoCorporativo" class="error-campo"></span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="Rol" class="form-label">Rol<span class="obligatorio" aria-hidden="true">*</span></label>
                        @* El value es el nombre del rol y no su número: es lo que espera la validación del servidor. *@
                        <select asp-for="Rol" class="form-select" aria-required="true">
                            <option value="">Seleccioná un rol</option>
                            <option value="@nameof(RolUsuario.Administrador)">Administrador</option>
                            <option value="@nameof(RolUsuario.Supervisor)">Supervisor</option>
                            <option value="@nameof(RolUsuario.Operador)">Operador</option>
                        </select>
                        <span asp-validation-for="Rol" class="error-campo"></span>
                    </div>
                </div>
            </div>

            <div class="panel-pie d-flex justify-content-end">
                <button id="boton-registrar-usuario" type="submit" class="btn btn-primary">
                    Registrar usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/registrar-usuario-formulario.js" asp-append-version="true"></script>
}
