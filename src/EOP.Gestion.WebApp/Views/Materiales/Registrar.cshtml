@model EOP.Gestion.WebApp.ViewModels.Materiales.RegistrarMaterialViewModel
@using EOP.Gestion.Core.Entidades.Catalogo

@{
    ViewData["Title"] = "Registrar material";
}

@* Formulario con el diseño de la guía (sección 14 de docs/diseno-visual/diseno-visual.md). *@

<div class="encabezado">
    <div>
        <h1>Registrar material</h1>
        <p>Ingresá los datos del nuevo material.</p>
    </div>
</div>

@* Mostramos un mensaje cuando el material se registra correctamente. *@
<partial name="_Mensajes" />

<div class="row g-4">
    <div class="col-xl-8">
        <form asp-controller="Materiales" asp-action="Registrar" method="post" class="panel">

            @Html.AntiForgeryToken()

            <div class="seccion-form">
                <h2>Datos del material</h2>
                <p class="descripcion">Nombre del material y su unidad de medida.</p>

                <!-- Mostramos los errores generales del formulario. -->
                <div asp-validation-summary="ModelOnly" class="resumen-errores" role="alert"></div>

                <div class="row g-3">
                    <!-- Nombre del material -->
                    <div class="col-md-8">
                        <label asp-for="Nombre" class="form-label">Nombre<span class="obligatorio" aria-hidden="true">*</span></label>
                        <input asp-for="Nombre" class="form-control" aria-required="true" />
                        <span asp-validation-for="Nombre" class="error-campo"></span>
                    </div>

                    <!-- Unidad de medida -->
                    <div class="col-md-4">
                        <label asp-for="Unidad" class="form-label">Unidad de medida<span class="obligatorio" aria-hidden="true">*</span></label>
                        <select asp-for="Unidad" class="form-select" aria-required="true">
                            <option value="">Seleccioná una unidad</option>
                            <optgroup label="Longitud">
                                <option value="@((int)UnidadMedida.Milimetro)">mm</option>
                                <option value="@((int)UnidadMedida.Centimetro)">cm</option>
                                <option value="@((int)UnidadMedida.Metro)">m</option>
                                <option value="@((int)UnidadMedida.Kilometro)">km</option>
                            </optgroup>
                            <optgroup label="Superficie">
                                <option value="@((int)UnidadMedida.CentimetroCuadrado)">cm²</option>
                                <option value="@((int)UnidadMedida.MetroCuadrado)">m²</option>
                            </optgroup>
                            <optgroup label="Volumen">
                                <option value="@((int)UnidadMedida.CentimetroCubico)">cm³</option>
                                <option value="@((int)UnidadMedida.MetroCubico)">m³</option>
                                <option value="@((int)UnidadMedida.Mililitro)">ml</option>
                                <option value="@((int)UnidadMedida.Litro)">litro</option>
                            </optgroup>
                            <optgroup label="Peso">
                                <option value="@((int)UnidadMedida.Gramo)">g</option>
                                <option value="@((int)UnidadMedida.Kilogramo)">kg</option>
                                <option value="@((int)UnidadMedida.Tonelada)">t</option>
                            </optgroup>
                            <optgroup label="Por pieza">
                                <option value="@((int)UnidadMedida.Unidad)">unidad</option>
                            </optgroup>
                        </select>
                        <span asp-validation-for="Unidad" class="error-campo"></span>
                    </div>
                </div>
            </div>

            <div class="seccion-form">
                <h2>Proveedor y precio</h2>
                <p class="descripcion">Primer proveedor del material, elegido entre los ya registrados, con su precio.</p>

                <div class="row g-3">
                    <!-- Seleccionamos un proveedor que ya exista en el sistema. -->
                    <div class="col-12">
                        <label asp-for="ProveedorId" class="form-label">Proveedor<span class="obligatorio" aria-hidden="true">*</span></label>
                        <select asp-for="ProveedorId"
                                asp-items="Model.Proveedores"
                                class="form-select"
                                aria-required="true">
                            <option value="">Seleccioná un proveedor</option>
                        </select>
                        <span asp-validation-for="ProveedorId" class="error-campo"></span>
                    </div>

                    <!-- Precio unitario -->
                    <div class="col-md-6">
                        <label asp-for="PrecioUnitario" class="form-label">Precio unitario<span class="obligatorio" aria-hidden="true">*</span></label>
                        <input asp-for="PrecioUnitario"
                               type="number"
                               step="any"
                               class="form-control"
                               aria-required="true" />
                        <span asp-validation-for="PrecioUnitario" class="error-campo"></span>
                    </div>

                    <!-- Moneda -->
                    <div class="col-md-6">
                        <label asp-for="Moneda" class="form-label">Moneda<span class="obligatorio" aria-hidden="true">*</span></label>
                        <select asp-for="Moneda" class="form-select" aria-required="true">
                            <option value="">Seleccioná una moneda</option>
                            <option value="UYU">UYU - Pesos uruguayos</option>
                            <option value="USD">USD - Dólares estadounidenses</option>
                        </select>
                        <span asp-validation-for="Moneda" class="error-campo"></span>
                    </div>
                </div>
            </div>

            <div class="panel-pie d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="small text-body-secondary"><span class="obligatorio ms-0" aria-hidden="true">*</span> Obligatorio</span>
                <button type="submit" class="btn btn-primary">
                    Registrar material
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
