@model List<EOP.Gestion.Core.DTOs.Clientes.ClienteListadoDto>

@{
    ViewData["Title"] = "Clientes";

    // Recuperamos los filtros que recibió el controlador.
    string busquedaActual = ViewBag.Busqueda as string ?? "";
    bool? activoSeleccionado = (bool?)ViewBag.Activo;

    // Con algún filtro puesto, un listado vacío significa "nada coincide" y conviene
    // ofrecer limpiar los filtros. Sin filtros, significa que todavía no hay clientes.
    bool hayFiltros = busquedaActual != "" || activoSeleccionado != null;
}

@*
    Listado de clientes (US-052) con el diseño de la guía: encabezado, panel de filtros
    y panel con la tabla (secciones 9, 12 y 13 de docs/diseno-visual/diseno-visual.md).

    Ojo con la tabla: las filas y celdas van como <tr> y <td> sin atributos, porque las
    pruebas de integración leen el listado buscando exactamente esas etiquetas.
*@

<div class="encabezado">
    <div>
        <h1>Clientes</h1>
        <p>Listado de clientes registrados en el sistema. Buscá por nombre o RUT y filtrá por estado.</p>
    </div>

    <a asp-controller="Clientes"
       asp-action="Registrar"
       class="btn btn-primary">
        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Registrar cliente
    </a>
</div>

<partial name="_Mensajes" />

<!-- Formulario de búsqueda y filtros -->
<form asp-controller="Clientes" asp-action="Index"
      method="get" class="panel mb-3" role="search" aria-label="Filtros de clientes">

    <div class="panel-cuerpo">
        <div class="row g-3 align-items-end">

            <!-- Buscar por nombre o RUT -->
            <div class="col-12 col-md-6 col-xl-5">
                <label for="busqueda" class="form-label">
                    Buscar por nombre o RUT
                </label>

                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                    <input type="text"
                           id="busqueda"
                           name="busqueda"
                           value="@busquedaActual"
                           class="form-control border-start-0"
                           placeholder="Nombre o RUT" />
                </div>
            </div>

            <!-- Filtrar por estado -->
            <div class="col-6 col-md-3 col-xl-3">
                <label for="activo" class="form-label">
                    Estado
                </label>

                <select id="activo" name="activo"
                        class="form-select">
                    <option value="" selected="@(activoSeleccionado == null)">
                        Todos
                    </option>
                    <option value="true" selected="@(activoSeleccionado == true)">
                        Activos
                    </option>
                    <option value="false" selected="@(activoSeleccionado == false)">
                        Inactivos
                    </option>
                </select>
            </div>

            <div class="col-6 col-md-3 col-xl-auto">
                <button type="submit" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-search me-1" aria-hidden="true"></i>Buscar
                </button>
            </div>
        </div>
    </div>

    <div class="panel-pie d-flex flex-wrap gap-2 justify-content-between align-items-center">
        <span class="text-body-secondary small">La búsqueda y el estado se combinan: se muestran los clientes que cumplen ambos.</span>
        <a class="btn btn-link btn-sm text-decoration-none p-0" asp-controller="Clientes" asp-action="Index">
            <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Limpiar filtros
        </a>
    </div>
</form>

<!-- Tabla de clientes -->
<section class="panel" aria-label="Resultados">
    @if (Model.Count == 0)
    {
        @* Estado vacío de la sección 17.1 de la guía. *@
        <div class="sin-resultados" role="status">
            @if (hayFiltros)
            {
                <i class="bi bi-search" aria-hidden="true"></i>
                <h2>No se encontraron clientes.</h2>
                <p>Probá con otro nombre o RUT, o cambiá el estado elegido.</p>
                <a class="btn btn-outline-secondary" asp-controller="Clientes" asp-action="Index">
                    <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Limpiar filtros
                </a>
            }
            else
            {
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <h2>No se encontraron clientes.</h2>
                <p>Todavía no hay clientes registrados.</p>
                <a class="btn btn-primary" asp-controller="Clientes" asp-action="Registrar">
                    <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>Registrar cliente
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover tabla">
                <thead>
                    <tr>
                        <th scope="col">Nombre</th>
                        <th scope="col">RUT</th>
                        <th scope="col">Correo contacto</th>
                        <th scope="col">Correo facturación</th>
                        <th scope="col">WhatsApp</th>
                        <th scope="col">Estado</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var cliente in Model)
                    {
                        <tr>
                            <td>@cliente.Nombre</td>
                            <td>@cliente.Rut</td>
                            @* Si un correo no se informó, no inventamos ningún valor (US-052). *@
                            <td>
                                @if (cliente.CorreoContacto != null)
                                {
                                    @cliente.CorreoContacto
                                }
                                else
                                {
                                    <span class="sin-dato">Sin informar</span>
                                }
                            </td>
                            <td>
                                @if (cliente.CorreoFacturacion != null)
                                {
                                    @cliente.CorreoFacturacion
                                }
                                else
                                {
                                    <span class="sin-dato">Sin informar</span>
                                }
                            </td>
                            <td>@cliente.NumeroWhatsApp</td>
                            <td>
                                @if (cliente.Activo)
                                {
                                    <span class="estado estado-exito">Activo</span>
                                }
                                else
                                {
                                    <span class="estado estado-cerrado">Inactivo</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel-pie">
            <span class="text-body-secondary small">
                @if (Model.Count == 1)
                {
                    @:Se muestra 1 cliente.
                }
                else
                {
                    @:Se muestran @Model.Count clientes.
                }
            </span>
        </div>
    }
</section>
