@model List<EOP.Gestion.Core.DTOs.Clientes.ClienteListadoDto>

@{
    ViewData["Title"] = "Clientes";

    // Recuperamos los filtros que recibió el controlador.
    string busquedaActual = ViewBag.Busqueda as string ?? "";
    bool? activoSeleccionado = (bool?)ViewBag.Activo;
}

<h2>Clientes</h2>

<p>Listado de clientes registrados en el sistema.</p>

<!-- Formulario de búsqueda y filtros -->
<form asp-controller="Clientes" asp-action="Index"
      method="get" class="row g-3 mb-4">

    <!-- Buscar por nombre o RUT -->
    <div class="col-md-6">
        <label for="busqueda" class="form-label">
            Buscar por nombre o RUT
        </label>

        <input type="text"
               id="busqueda"
               name="busqueda"
               value="@busquedaActual"
               class="form-control"
               placeholder="Nombre o RUT" />
    </div>

    <!-- Filtrar por estado -->
    <div class="col-md-3">
        <label for="activo" class="form-label">
            Estado
        </label>

        <select id="activo" name="activo"
                class="form-select">
            <option value="" selected="@(activoSeleccionado == null)">
                Todos
            </option>
            <option value="true" selected="@(activoSeleccionado == true)">
                Activos
            </option>
            <option value="false" selected="@(activoSeleccionado == false)">
                Inactivos
            </option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">
            Buscar
        </button>
    </div>
</form>

<a asp-controller="Clientes"
   asp-action="Registrar"
   class="btn btn-success mb-3">
    Registrar cliente
</a>

<!-- Tabla de clientes -->
<div class="table-responsive">
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>RUT</th>
                <th>Correo contacto</th>
                <th>Correo facturación</th>
                <th>WhatsApp</th>
                <th>Estado</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Count == 0)
            {
                <tr>
                    <td colspan="6" class="text-center">
                        No se encontraron clientes.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var cliente in Model)
                {
                    <tr>
                        <td>@cliente.Nombre</td>
                        <td>@cliente.Rut</td>
                        <td>@(cliente.CorreoContacto ?? "Sin informar")</td>
                        <td>@(cliente.CorreoFacturacion ?? "Sin informar")</td>
                        <td>@cliente.NumeroWhatsApp</td>
                        <td>
                            @if (cliente.Activo)
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
