@{
    ViewData["Title"] = "Sesión cerrada";
}

@* Pantalla que aparece después de cerrar sesión. La ve alguien sin sesión,
   por eso la acción que la muestra tiene [AllowAnonymous]. *@

@* Sin sesión, el layout la muestra sin menú, con la marca arriba y este panel centrado. *@
<section class="panel panel-cuerpo p-4 text-center">
    <h1 class="h4 fw-bold">Cerraste sesión</h1>
    <p class="text-body-secondary">Tu sesión en EOP terminó correctamente.</p>
    <a class="btn btn-primary" asp-controller="Cuenta" asp-action="IniciarSesion">Iniciar sesión de nuevo</a>
</section>
